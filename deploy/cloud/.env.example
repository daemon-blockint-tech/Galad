# Template for deploy/cloud/.env — copy it, then fill in real values:
#   cp .env.example .env
# The copy is gitignored; this template must only ever hold placeholders.

# REQUIRED — signs session cookies and marketplace JWTs, and derives the
# credential-encryption key. No default: compose aborts if it is unset or empty.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

SUPABASE_PG_URL=postgresql://postgres:password@db.supabase.co:5432/postgres
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
ACME_EMAIL=admin@example.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
